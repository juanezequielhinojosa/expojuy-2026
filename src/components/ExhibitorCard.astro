---
// Componente: Tarjeta de expositor
import type { Exhibitor } from '../data/exhibitors';
import SectorIcon from './SectorIcon.astro';
import Icon from './Icon.astro';

interface Props {
  exhibitor: Exhibitor;
  index?: number;
}

const { exhibitor } = Astro.props;
---

<article class="ex-card">
  <SectorIcon rubro={exhibitor.rubro} size="md" />
  <div class="ex-body">
    <h3 class="ex-name">{exhibitor.name}</h3>
    <p class="ex-org">
      <span class="chip">{exhibitor.rubro}</span>
      <span class="ex-origin">
        <span class="ex-pin"><Icon name="mappin" size={14} /></span> {exhibitor.origin}
      </span>
    </p>
    <p class="ex-desc">{exhibitor.description}</p>
  </div>
</article>

<style>
  .ex-card {
    display: flex;
    gap: 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 1.25rem;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(
          135deg,
          color-mix(in srgb, var(--turquesa) 55%, transparent),
          color-mix(in srgb, var(--brand-500) 65%, transparent)
        )
        border-box;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ex-card:hover {
    transform: translateY(-5px);
    box-shadow:
      0 22px 42px -18px rgba(43, 27, 94, 0.32),
      -18px 22px 46px -16px rgba(37, 192, 212, 0.6),
      18px -22px 46px -16px rgba(119, 79, 240, 0.7);
  }

  .ex-card .chip {
    background: color-mix(in srgb, var(--turquesa) 12%, transparent);
    color: var(--turquesa);
    border-color: color-mix(in srgb, var(--turquesa) 45%, transparent);
  }

  .ex-body {
    min-width: 0;
  }

  .ex-name {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .ex-org {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .ex-origin {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .ex-pin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--turquesa), var(--brand-500));
    box-shadow: 0 4px 10px -4px rgba(37, 192, 212, 0.65);
  }

  .ex-desc {
    margin: 0;
    font-size: 0.95rem;
  }
</style>