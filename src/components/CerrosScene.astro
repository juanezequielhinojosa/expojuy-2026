---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={[className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1440 420"
  preserveAspectRatio="xMidYMax slice"
  role="img"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="ej-sun" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffe2a3" />
      <stop offset="1" stop-color="#e8a33d" />
    </linearGradient>
    <radialGradient id="ej-sun-glow">
      <stop offset="0" stop-color="#e8a33d" stop-opacity="0.55" />
      <stop offset="1" stop-color="#e8a33d" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Halo del sol -->
  <circle cx="1105" cy="120" r="150" fill="url(#ej-sun-glow)" />
  <!-- Sol -->
  <circle cx="1105" cy="120" r="54" fill="url(#ej-sun)" />
  <circle cx="1105" cy="120" r="54" fill="none" stroke="#ffe2a3" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="4 8" />

  <!-- Serranía profunda -->
  <path
    d="M0 262 L170 158 L330 236 L520 118 L705 252 L895 158 L1065 244 L1240 142 L1440 252 L1440 420 L0 420 Z"
    fill="#0b5c86"
    opacity="0.55"
  />
  <!-- Serranía media -->
  <path
    d="M0 302 L160 206 L330 288 L515 186 L705 316 L900 214 L1080 300 L1280 192 L1440 302 L1440 420 L0 420 Z"
    fill="#0a4c70"
  />
  <!-- Serranía cercana -->
  <path
    d="M0 362 L210 264 L430 342 L650 242 L870 352 L1080 274 L1290 358 L1440 302 L1440 420 L0 420 Z"
    fill="#06324d"
  />
</svg>