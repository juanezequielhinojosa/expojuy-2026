---
// Componente: Reproductor de video YouTube embebido
interface Props {
  videoId: string;
  title?: string;
  autoplay?: boolean;
  loop?: boolean;
  class?: string;
}

const { videoId, title = 'Video ExpoJuy 2026', autoplay = false, loop = false, class: className } = Astro.props;

const params = [
  'rel=0',
  'modestbranding=1',
  autoplay ? 'autoplay=1&mute=1&playsinline=1' : '',
  loop ? 'loop=1&playlist=' + videoId : '',
]
  .filter(Boolean)
  .join('&');
---

<div class:list={[className, 'video-embed', autoplay && 'video-embed--bg']}>
  <iframe
    class="video-frame"
    src={`https://www.youtube-nocookie.com/embed/${videoId}?${params}`}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerPolicy="strict-origin-when-cross-origin"
    allowFullScreen
  ></iframe>
</div>

<style>
  .video-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 12px 32px -10px rgba(59, 42, 130, 0.28);
  }

  .video-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>