---
import { site } from '../data/site';
import Icon from './Icon.astro';
import CerrosScene from './CerrosScene.astro';

const stats = [
  { icon: 'building', num: '200+', label: 'stands de empresas' },
  { icon: 'users', num: '30.000', label: 'visitantes esperados' },
  { icon: 'calendar', num: '4', label: 'días de eventos' },
  { icon: 'globe', num: '4', label: 'países del Corredor' },
];
---

<section class="hero">
  <CerrosScene class="hero-scene" />

  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="chip hero-chip">
        <Icon name="calendar" size={15} strokeWidth={2.2} />
        {site.edition} · {site.dates}
      </span>
      <h1 class="hero-title">
        La muestra multisectorial más importante del <em>norte argentino</em>
      </h1>
      <p class="hero-lede">
        {site.tagline}. Empresas, productores, servicios, cultura y rondas de
        negocios internacionales en el corazón del Corredor Bioceánico de
        Capricornio.
      </p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/agenda/">
          Ver la agenda <Icon name="calendar" size={18} />
        </a>
        <a class="btn btn-outline" href="/expositores/">
          Explorar expositores <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>

    <div class="hero-card" aria-label="Datos del evento">
      <span class="hero-card-title">
        <Icon name="info" size={18} /> Datos del evento
      </span>
      <dl class="hero-facts">
        <div>
          <dt><Icon name="calendar" size={15} /> Fechas</dt>
          <dd>{site.dates}</dd>
        </div>
        <div>
          <dt><Icon name="mappin" size={15} /> Lugar</dt>
          <dd>Ciudad Cultural · San Salvador de Jujuy</dd>
        </div>
        <div>
          <dt><Icon name="sparkles" size={15} /> Lema</dt>
          <dd>{site.tagline}</dd>
        </div>
        <div>
          <dt><Icon name="ticket" size={15} /> Entradas</dt>
          <dd>Próximamente por este sitio</dd>
        </div>
      </dl>
      <a class="btn btn-primary hero-cta" href="/contacto/">
        Quiero participar <Icon name="send" size={18} />
      </a>
    </div>
  </div>

  <div class="hero-stats">
    <div class="container">
      {
        stats.map((s) => (
          <div class="hero-stat">
            <span class="hero-stat-ico" aria-hidden="true">
              <Icon name={s.icon} size={22} strokeWidth={1.8} />
            </span>
            <span>
              <span class="hero-stat-num">{s.num}</span>
              <span class="hero-stat-label">{s.label}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(1100px 480px at 88% -10%, rgba(10, 116, 165, 0.5), transparent 60%),
      linear-gradient(160deg, #032f47 0%, #044463 55%, #065a82 100%);
    color: #fff;
    padding: 5rem 0 0;
    overflow: hidden;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.95;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
    padding-bottom: 4rem;
  }

  .hero-copy {
    position: relative;
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent-gold);
    border-color: rgba(232, 163, 61, 0.5);
    background: rgba(232, 163, 61, 0.12);
  }

  .hero-title {
    color: #fff;
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    margin: 1.1rem 0 1rem;
    text-wrap: balance;
  }

  .hero-title em {
    font-style: normal;
    color: var(--accent-gold);
  }

  .hero-lede {
    font-size: 1.08rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 34em;
    margin-bottom: 1.8rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero-card {
    position: relative;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
    border-radius: var(--radius);
    padding: 1.6rem;
    box-shadow: 0 22px 48px -18px rgba(0, 0, 0, 0.45);
  }

  .hero-card-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--accent-gold);
    margin-bottom: 1.1rem;
  }

  .hero-facts {
    margin: 0 0 1.4rem;
    display: grid;
    gap: 0.85rem;
  }

  .hero-facts div {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding-bottom: 0.75rem;
  }

  .hero-facts div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .hero-facts dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 700;
  }

  .hero-facts dd {
    margin: 0.2rem 0 0;
    font-weight: 500;
    line-height: 1.5;
  }

  .hero-cta {
    width: 100%;
    justify-content: center;
  }

  .hero .btn-outline {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }

  .hero .btn-outline:hover {
    background: #fff;
    color: var(--brand-900);
  }

  .hero-stats {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(3, 47, 71, 0.45);
    backdrop-filter: blur(4px);
  }

  .hero-stats > .container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .hero-stat {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.15rem 1.25rem;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }

  .hero-stat:first-child {
    border-left: 0;
  }

  .hero-stat-ico {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 12px;
    background: rgba(232, 163, 61, 0.16);
    border: 1px solid rgba(232, 163, 61, 0.35);
    color: var(--accent-gold);
  }

  .hero-stat-num {
    display: block;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.5rem;
    color: #fff;
    line-height: 1.1;
  }

  .hero-stat-label {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 920px) {
    .hero-stats > .container {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-stat:nth-child(3) {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
    }

    .hero-stat:nth-child(4) {
      border-top: 1px solid rgba(255, 255, 255, 0.16);
    }
  }

  @media (max-width: 820px) {
    .hero {
      padding-top: 3.2rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 3rem;
    }
  }

  @media (max-width: 520px) {
    .hero-stats > .container {
      grid-template-columns: 1fr 1fr;
    }

    .hero-stat {
      padding: 0.9rem 0.75rem;
    }

    .hero-stat-ico {
      width: 38px;
      height: 38px;
    }
  }
</style>