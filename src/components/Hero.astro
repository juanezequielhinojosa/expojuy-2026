---
import { site } from '../data/site';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="chip">{site.edition} · {site.dates}</span>
      <h1 class="hero-title">
        La muestra multisectorial más importante del norte argentino
      </h1>
      <p class="hero-lede">
        {site.tagline}. Empresas, productores, servicios, cultura y rondas de
        negocios internacionales en el corazón del Corredor Bioceánico de
        Capricornio.
      </p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/agenda/">Ver la agenda</a>
        <a class="btn btn-outline" href="/expositores/">Explorar expositores</a>
      </div>
    </div>
    <div class="hero-card" aria-label="Datos del evento">
      <dl class="hero-facts">
        <div>
          <dt>Fechas</dt>
          <dd>{site.dates}</dd>
        </div>
        <div>
          <dt>Lugar</dt>
          <dd>Ciudad Cultural · San Salvador de Jujuy</dd>
        </div>
        <div>
          <dt>Lema</dt>
          <dd>{site.tagline}</dd>
        </div>
        <div>
          <dt>Entradas</dt>
          <dd>Próximamente por este sitio</dd>
        </div>
      </dl>
      <a class="btn btn-primary" href="/contacto/">Quiero participar</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(1200px 500px at 85% -10%, rgba(4, 68, 99, 0.35), transparent 60%),
      linear-gradient(160deg, #032f47 0%, #044463 60%, #065a82 100%);
    color: #fff;
    padding: 5rem 0 5.5rem;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-title {
    color: #fff;
    font-size: clamp(1.9rem, 4vw, 3rem);
    margin: 1rem 0 1rem;
  }

  .hero-lede {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.88);
    max-width: 34em;
    margin-bottom: 1.8rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
    border-radius: var(--radius);
    padding: 1.75rem;
  }

  .hero-facts {
    margin: 0 0 1.5rem;
    display: grid;
    gap: 1rem;
  }

  .hero-facts div {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding-bottom: 0.75rem;
  }

  .hero-facts dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-gold);
    font-weight: 700;
  }

  .hero-facts dd {
    margin: 0.15rem 0 0;
    font-weight: 500;
  }

  .chip {
    color: var(--accent-gold);
    border-color: rgba(232, 163, 61, 0.5);
    background: rgba(232, 163, 61, 0.12);
  }

  .hero .btn-outline {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }

  .hero .btn-outline:hover {
    background: #fff;
    color: var(--brand-900);
  }

  @media (max-width: 820px) {
    .hero {
      padding: 3.5rem 0;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>