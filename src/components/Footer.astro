---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h3>{site.name}</h3>
        <p>
          {site.tagline}. {site.dates} en el predio de la Ciudad Cultural de San
          Salvador de Jujuy.
        </p>
      </div>

      <div>
        <h3>Enlaces</h3>
        <ul class="footer-links">
          {
            site.navigation.slice(0, 5).map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3>Organiza</h3>
        <p>{site.organizer}</p>
        <p>
          Con el acompañamiento del Ministerio de Desarrollo Económico y
          Producción de la Provincia de Jujuy.
        </p>
      </div>

      <div>
        <h3>Redes</h3>
        <ul class="footer-links">
          {
            site.social.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.name} · {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
    <div class="footer-bottom">
      © 2026 {site.name} — Propuesta conceptual para el Desafío Digital ExpoJuy
      2026. Sitio no oficial.
    </div>
  </div>
</footer>

<style>
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.4rem;
  }
</style>