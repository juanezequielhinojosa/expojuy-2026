---
// Componente: Pie de página (marca, enlaces, contacto y redes)
import { site } from '../data/site';
import SocialIcon from './SocialIcon.astro';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;

const socialKey = (name: string): string => {
  const n = name.toLowerCase();
  if (n.includes('instagram')) return 'instagram';
  if (n.includes('facebook')) return 'facebook';
  if (n.includes('twitter') || n.includes('x /')) return 'x';
  if (n.includes('linkedin')) return 'linkedin';
  if (n.includes('youtube')) return 'youtube';
  return 'globe';
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <img class="footer-logo" src={base + 'logos/logo-expojuy.png'} alt="ExpoJuy" width="44" height="60" />
        <div class="footer-brand-text">
          <h3 class="footer-brand-name">{site.name}</h3>
          <p class="footer-tagline">{site.tagline}</p>
        </div>
      </div>
      <p class="footer-desc">
        {site.dates} en el predio de la Ciudad Cultural de San Salvador de
        Jujuy. Empresas, productores, servicios, cultura y negocios
        internacionales del NOA.
      </p>
    </div>

    <div class="footer-organizers">
      <span class="footer-organizers-label">Organizan y acompañan</span>
      <div class="footer-logos">
        <a
          class="footer-logo-link"
          href="https://expojuy.camcomexjujuy.com.ar"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Cámara de Comercio Exterior de Jujuy"
        >
          <img src={base + 'logos/logo-camara.png'} alt="Cámara de Comercio Exterior de Jujuy" />
        </a>
        <a
          class="footer-logo-link"
          href="https://www.produccion.jujuy.gob.ar"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ministerio de Desarrollo Económico y Producción"
        >
          <img src={base + 'logos/logo-ministerio.png'} alt="Ministerio de Desarrollo Económico y Producción" />
        </a>
        <a
          class="footer-logo-link"
          href="https://www.sansalvadordejujuy.gob.ar"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Municipalidad de San Salvador de Jujuy"
        >
          <img src={base + 'logos/logo-muni.png'} alt="Municipalidad de San Salvador de Jujuy" />
        </a>
      </div>
    </div>

    <div class="footer-cols">
      <div>
        <h3>Enlaces</h3>
        <ul class="footer-links">
          {
            site.navigation.slice(0, 5).map((item) => (
              <li>
                <a href={item.href}>
                  <Icon name="chevron" size={14} class="link-chev" /> {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3>Organiza</h3>
        <p class="footer-org">
          <span class="footer-org-ico">
            <Icon name="building" size={16} />
          </span>
          {site.organizer}
        </p>
        <p class="footer-org sub">
          Con el acompañamiento del Ministerio de Desarrollo Económico y
          Producción de la Provincia de Jujuy.
        </p>
      </div>

      <div>
        <h3>Redes</h3>
        <ul class="footer-social">
          {
            site.social.map((s) => {
              const key = socialKey(s.name);
              return (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                    <SocialIcon name={key} size={18} />
                  </a>
                </li>
              );
            })
          }
        </ul>
        <p class="footer-mail">
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" size={15} /> {site.email}
          </a>
        </p>
      </div>
    </div>

    <div class="footer-legal">
      <span>© 2026 {site.name}</span>
      <span>Propuesta conceptual · Desafío Digital ExpoJuy 2026</span>
      <span>Sitio no oficial</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
  }

  .site-footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--turquesa), var(--brand-500), var(--accent-gold));
    opacity: 0.7;
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding: 0.4rem 0 1.8rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .footer-logo {
    display: block;
    height: 60px;
    width: auto;
    flex: none;
  }

  .footer-brand-name {
    color: #fff;
    font-size: 1.5rem;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .footer-tagline {
    margin: 0.1rem 0 0;
    background: linear-gradient(90deg, var(--turquesa), #6143C9);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--turquesa);
    font-size: 0.92rem;
    letter-spacing: 0.02em;
  }

  .footer-desc {
    margin: 0;
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.6;
  }

  .footer-organizers {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    flex-wrap: wrap;
    margin-bottom: 2.2rem;
    padding: 1.3rem 1.6rem;
    border: 1px solid rgba(37, 192, 212, 0.28);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.04);
  }

  .footer-organizers-label {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .footer-logos {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .footer-logo-link {
    display: block;
    opacity: 0.92;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .footer-logo-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .footer-logo-link img {
    display: block;
    height: 90px;
    width: auto;
  }

  .footer-cols {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr 1.4fr 1.4fr;
    padding-top: 0.4rem;
  }

  .site-footer h3 {
    color: #fff;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1.1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--turquesa);
    display: inline-block;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.55rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.82);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #fff;
  }

  .link-chev {
    color: var(--turquesa);
    font-size: 0.7rem;
  }

  .footer-org {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.5;
  }

  .footer-org-ico {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--turquesa), var(--brand-500));
    color: #fff;
    box-shadow: 0 6px 14px -6px rgba(37, 192, 212, 0.6);
  }

  .footer-org.sub {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .footer-social {
    list-style: none;
    padding: 0;
    margin: 0 0 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .footer-social li {
    margin: 0;
  }

  .footer-social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--turquesa), var(--brand-500));
    box-shadow: 0 10px 22px -8px rgba(37, 192, 212, 0.45);
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.3));
    transition: all 0.2s ease;
  }

  .footer-social a svg {
    color: #fff;
  }

  .footer-social a:hover {
    transform: translateY(-2px) scale(1.04);
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.35));
    color: #fff;
  }

  .footer-social a:hover svg {
    color: #fff;
  }

  .footer-mail a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: rgba(255, 255, 255, 0.82);
    transition: color 0.2s ease;
  }

  .footer-mail a:hover {
    color: #fff;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    margin-top: 2.8rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 960px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-cols {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-organizers {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
