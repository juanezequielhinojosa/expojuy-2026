---
// Componente: Encabezado de sección (kicker + título + lede)
interface Props {
  kicker?: string;
  title: string;
  lede?: string;
}

const { kicker, title, lede } = Astro.props;
---

<div class="section-head">
  {kicker && <span class="kicker">{kicker}</span>}
  <h2>{title}</h2>
  {lede && <p>{lede}</p>}
</div>