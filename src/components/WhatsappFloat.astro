---
// Componente: Botón flotante de WhatsApp
interface Props {
  phone?: string;
  message?: string;
}

const {
  phone = '5493884212955',
  message = 'Hola! Quiero más información sobre ExpoJuy 2026.',
} = Astro.props;

const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  class="wa-float"
  id="wa-float"
  href={waUrl}
  target="_blank"
  rel="noopener"
  aria-label="Contactar por WhatsApp (arrastrable para mover)"
  title="Mantén presionado para mover"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
  </svg>
  <span class="wa-tooltip">¿Hablamos?</span>
</a>

<style>
  .wa-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #25d366, #128c7e);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 10px 28px -6px rgba(37, 211, 102, 0.55);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    animation: wa-pulse 2.4s ease-in-out infinite;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .wa-float.dragging {
    animation: none;
    cursor: grabbing;
    transition: none;
  }

  .wa-float:not(.dragging):hover {
    transform: scale(1.05);
    box-shadow: 0 14px 34px -6px rgba(37, 211, 102, 0.7);
    color: #fff;
  }

  .wa-float svg {
    width: 28px;
    height: 28px;
    pointer-events: none;
  }

  .wa-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: var(--brand-900);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s ease;
    box-shadow: 0 6px 16px -4px rgba(59, 42, 130, 0.3);
  }

  .wa-tooltip::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border: 6px solid transparent;
    border-left-color: var(--brand-900);
  }

  .wa-float:not(.dragging):hover .wa-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @keyframes wa-pulse {
    0%, 100% {
      box-shadow: 0 10px 28px -6px rgba(37, 211, 102, 0.55), 0 0 0 0 rgba(37, 211, 102, 0.5);
    }
    50% {
      box-shadow: 0 10px 28px -6px rgba(37, 211, 102, 0.55), 0 0 0 14px rgba(37, 211, 102, 0);
    }
  }

  @media (max-width: 480px) {
    .wa-float {
      bottom: 18px;
      right: 18px;
      width: 52px;
      height: 52px;
    }

    .wa-float svg {
      width: 26px;
      height: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      animation: none;
    }
  }
</style>

<script>
  const float = document.getElementById('wa-float');
  if (float) {
    const STORAGE_KEY = 'wa-float-position';

    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const pos = JSON.parse(saved);
        float.style.left = pos.left;
        float.style.top = pos.top;
        float.style.right = 'auto';
        float.style.bottom = 'auto';
      } catch (_) { /* ignore */ }
    }

    let isDragging = false;
    let didMove = false;
    let startX = 0;
    let startY = 0;
    let originLeft = 0;
    let originTop = 0;
    let pointerId = null;

    const onPointerDown = (e) => {
      if (e.button !== undefined && e.button !== 0) return;
      const pointer = e.touches ? e.touches[0] : e;
      isDragging = true;
      didMove = false;
      pointerId = pointer.identifier ?? null;

      const rect = float.getBoundingClientRect();
      startX = pointer.clientX;
      startY = pointer.clientY;
      originLeft = rect.left;
      originTop = rect.top;

      float.style.left = originLeft + 'px';
      float.style.top = originTop + 'px';
      float.style.right = 'auto';
      float.style.bottom = 'auto';

      float.classList.add('dragging');
      float.setPointerCapture?.(pointer.pointerId);
      e.preventDefault();
    };

    const onPointerMove = (e) => {
      if (!isDragging) return;
      const pointer = e.touches
        ? Array.from(e.touches).find((t) => t.identifier === pointerId) || e.touches[0]
        : e;

      const dx = pointer.clientX - startX;
      const dy = pointer.clientY - startY;
      if (!didMove && Math.hypot(dx, dy) < 5) return;
      didMove = true;

      const size = float.offsetWidth;
      const maxX = window.innerWidth - size;
      const maxY = window.innerHeight - size;

      let newLeft = originLeft + dx;
      let newTop = originTop + dy;

      newLeft = Math.max(0, Math.min(newLeft, maxX));
      newTop = Math.max(0, Math.min(newTop, maxY));

      float.style.left = newLeft + 'px';
      float.style.top = newTop + 'px';
    };

    const onPointerUp = () => {
      if (!isDragging) return;
      isDragging = false;
      float.classList.remove('dragging');

      if (didMove) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          left: float.style.left,
          top: float.style.top,
        }));
      }
    };

    float.addEventListener('mousedown', onPointerDown);
    float.addEventListener('touchstart', onPointerDown, { passive: false });
    document.addEventListener('mousemove', onPointerMove);
    document.addEventListener('touchmove', onPointerMove, { passive: false });
    document.addEventListener('mouseup', onPointerUp);
    document.addEventListener('touchend', onPointerUp);
    document.addEventListener('touchcancel', onPointerUp);

    float.addEventListener('click', (e) => {
      if (didMove) {
        e.preventDefault();
        didMove = false;
      }
    });
  }
</script>
