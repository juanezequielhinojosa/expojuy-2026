---
// Componente: Tarjeta de noticia
import type { NewsItem } from '../data/news';
import Icon from './Icon.astro';

interface Props {
  item: NewsItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;

const pretty = new Intl.DateTimeFormat('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(item.date + 'T12:00:00'));

const base = import.meta.env.BASE_URL;

const PHOTOS = [
  base + 'img/hero/hero-slide-1.jpg',
  base + 'img/hero/hero-slide-2.jpg',
  base + 'img/hero/hero-slide-3.jpg',
  base + 'img/hero/hero-slide-4.jpg',
  base + 'img/hero/hero-slide-5.jpg',
];

const photo = PHOTOS[index % PHOTOS.length];
---

<article class="news-card">
  <div class="news-cover">
    <img src={photo} alt="" loading="lazy" />
    <time class="news-date" datetime={item.date}>
      {pretty}
    </time>
  </div>
  <div class="news-body">
    <h3>{item.title}</h3>
    <p>{item.excerpt}</p>
    <a href="#novedades" tabindex="-1" aria-hidden="true">
      Leer más <Icon name="arrow" size={15} />
    </a>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .news-card:hover {
    transform: translateY(-5px);
    box-shadow:
      0 22px 42px -18px rgba(43, 27, 94, 0.32),
      -18px 22px 46px -16px rgba(37, 192, 212, 0.6),
      18px -22px 46px -16px rgba(119, 79, 240, 0.7);
  }

  .news-cover {
    position: relative;
    min-height: 150px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-bottom: 3px solid var(--turquesa);
  }

  .news-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(37, 16, 54, 0.06) 0%,
        rgba(37, 16, 54, 0.28) 100%
      );
  }

  .news-date {
    position: absolute;
    z-index: 1;
    left: 0.4rem;
    bottom: 0.6rem;
    display: inline-block;
    padding: 0.34rem 0.68rem;
    font-size: 0.64rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #fff;
    background: linear-gradient(135deg, var(--turquesa), var(--brand-500));
    border-radius: 999px;
    box-shadow: 0 10px 22px -8px rgba(37, 192, 212, 0.45);
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.4));
  }

  .news-body {
    padding: 1.35rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .news-body h3 {
    font-size: 1.12rem;
    margin: 0;
  }

  .news-body p {
    margin: 0;
    flex: 1;
  }

  .news-body a {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
    color: var(--brand-500);
  }
</style>