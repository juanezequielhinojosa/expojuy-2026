---
// Componente: Ícono de sector con gradiente propio
import Icon from './Icon.astro';

interface Props {
  rubro: string;
  size?: 'sm' | 'md' | 'lg';
  plain?: boolean;
}

const { rubro, size = 'md', plain = false } = Astro.props;

const SECTORS: Record<string, { icon: string; from: string; to: string }> = {
  Minería: { icon: 'gem', from: '#25C0D4', to: '#6143C9' },
  Agroindustria: { icon: 'leaf', from: '#774FF0', to: '#25C0D4' },
  Turismo: { icon: 'mountain', from: '#A18BFF', to: '#25C0D4' },
  Industria: { icon: 'cog', from: '#5A3FC0', to: '#25C0D4' },
  Tecnología: { icon: 'cpu', from: '#25C0D4', to: '#820CD0' },
  Comercio: { icon: 'cart', from: '#4E3AA8', to: '#25C0D4' },
  Servicios: { icon: 'briefcase', from: '#25C0D4', to: '#774FF0' },
  Artesanías: { icon: 'vase', from: '#25C0D4', to: '#BB8CFF' },
};

const s = SECTORS[rubro] ?? { icon: 'building', from: '#6143C9', to: '#2B1B5E' };
---

<span
  class:list={['sector-icon', `sector-icon-${size}`, { 'sector-icon-plain': plain }]}
  style={`--g1:${s.from};--g2:${s.to}`}
  aria-hidden="true"
>
  <Icon name={s.icon} size={size === 'lg' ? 30 : size === 'sm' ? 18 : 24} strokeWidth={1.8} />
</span>

<style>
  .sector-icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, var(--g1), var(--g2));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 6px 16px -6px rgba(43, 27, 94, 0.55);
  }

  .sector-icon-sm {
    width: 42px;
    height: 42px;
    border-radius: 12px;
  }

  .sector-icon-md {
    width: 54px;
    height: 54px;
  }

  .sector-icon-lg {
    width: 78px;
    height: 78px;
    border-radius: 20px;
  }

  .sector-icon-plain {
    background: none !important;
    box-shadow: none;
    border-radius: 0;
    color: #fff;
  }
</style>