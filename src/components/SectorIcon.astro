---
import Icon from './Icon.astro';

interface Props {
  rubro: string;
  size?: 'sm' | 'md' | 'lg';
}

const { rubro, size = 'md' } = Astro.props;

const SECTORS: Record<string, { icon: string; from: string; to: string }> = {
  Minería: { icon: 'gem', from: '#0a74a5', to: '#032f47' },
  Agroindustria: { icon: 'leaf', from: '#57a44a', to: '#2f6b2c' },
  Turismo: { icon: 'mountain', from: '#e8a33d', to: '#8a5a13' },
  Industria: { icon: 'cog', from: '#6b7a86', to: '#2b3540' },
  Tecnología: { icon: 'cpu', from: '#8a63d2', to: '#4a2a8a' },
  Comercio: { icon: 'cart', from: '#d4703f', to: '#7c321d' },
  Servicios: { icon: 'briefcase', from: '#2f9dbb', to: '#0d4d5f' },
  Artesanías: { icon: 'vase', from: '#c98a5b', to: '#6f4426' },
};

const s = SECTORS[rubro] ?? { icon: 'building', from: '#0a74a5', to: '#032f47' };
---

<span
  class:list={['sector-icon', `sector-icon-${size}`]}
  style={`--g1:${s.from};--g2:${s.to}`}
  aria-hidden="true"
>
  <Icon name={s.icon} size={size === 'lg' ? 30 : size === 'sm' ? 18 : 24} strokeWidth={1.8} />
</span>

<style>
  .sector-icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, var(--g1), var(--g2));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 6px 16px -6px rgba(3, 47, 71, 0.55);
  }

  .sector-icon-sm {
    width: 42px;
    height: 42px;
    border-radius: 12px;
  }

  .sector-icon-md {
    width: 54px;
    height: 54px;
  }

  .sector-icon-lg {
    width: 78px;
    height: 78px;
    border-radius: 20px;
  }
</style>