---
// Página: Sponsors e instituciones
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import { sponsors } from '../data/sponsors';

const base = import.meta.env.BASE_URL;

const thematics = ['award', 'target', 'sparkles', 'heart', 'truck', 'globe'];
const iconFor = (i: number) => thematics[i % thematics.length];
---

<Layout
  title="Sponsors"
  description="Instituciones y sponsors que acompañan ExpoJuy 2026."
>
  <section class="section">
    <div class="container">
      <SectionTitle
        kicker="Sponsors"
        title="Quiénes nos acompañan"
        lede="Instituciones públicas y privadas que hacen posible la muestra. El listado final se actualiza con el programa oficial."
      />

      <div class="sponsor-block">
        <h3>Institucional</h3>
        <div class="sponsor-grid">
          {sponsors
            .filter((s) => s.level === 'Institucional')
            .map((s) => (
              <div class="sponsor-card">
                {s.logo ? (
                  <span
                    class:list={[
                      'sp-logo-tile',
                      { 'sp-logo-tile--dark': s.darkTile },
                      { 'sp-logo-tile--cover': s.cover },
                      { 'sp-logo-tile--cover-fill': s.coverFill },
                    ]}
                    aria-hidden="true"
                  >
                    <img src={s.logo} alt="" loading="lazy" />
                  </span>
                ) : (
                  <span class="sp-icon-tile" aria-hidden="true">
                    <Icon name="building" size={22} strokeWidth={1.8} />
                  </span>
                )}
                <span class="sp-name">{s.name}</span>
              </div>
            ))}
        </div>
      </div>

      <div class="sponsor-block">
        <h3>Sponsors comerciales</h3>
        <div class="sponsor-grid">
          {sponsors
            .filter((s) => s.level !== 'Institucional')
            .map((s, i) => (
              <div class="sponsor-card">
                {s.logo ? (
                  <span
                    class:list={[
                      'sp-logo-tile',
                      { 'sp-logo-tile--dark': s.darkTile },
                      { 'sp-logo-tile--cover': s.cover },
                      { 'sp-logo-tile--cover-fill': s.coverFill },
                    ]}
                    aria-hidden="true"
                  >
                    <img src={s.logo} alt="" loading="lazy" />
                  </span>
                ) : (
                  <span class="sp-icon-tile sp-icon-tile--gold" aria-hidden="true">
                    <Icon name={iconFor(i)} size={22} strokeWidth={1.8} />
                  </span>
                )}
                <span class="sp-name">{s.name}</span>
              </div>
            ))}
        </div>
      </div>

      <div class="cta-sponsor">
        <h3>¿Querés ser sponsor?</h3>
        <p>
          Sumá tu marca a la vidriera más importante del norte argentino.
        </p>
        <a class="btn btn-accent" href={base + 'contacto/'}>Hablemos</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sponsor-block {
    margin-bottom: 2.5rem;
  }

  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
  }

  .sponsor-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(
          135deg,
          color-mix(in srgb, var(--turquesa) 55%, transparent),
          color-mix(in srgb, var(--brand-500) 65%, transparent)
        )
        border-box;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sponsor-card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 22px 42px -18px rgba(43, 27, 94, 0.32),
      -18px 22px 46px -16px rgba(37, 192, 212, 0.5),
      18px -22px 46px -16px rgba(119, 79, 240, 0.6);
  }

  .sp-icon-tile {
    flex: 0 0 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, var(--turquesa), var(--brand-600));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 8px 18px -8px rgba(59, 42, 130, 0.5);
  }

  .sp-icon-tile--gold {
    background: linear-gradient(135deg, var(--brand-600), var(--turquesa));
    color: #fff;
  }

  .sp-logo-tile {
    flex: 0 0 118px;
    height: 66px;
    display: grid;
    place-items: center;
    padding: 0.45rem 0.65rem;
    background: #fff;
    border: 2px solid var(--tint-border);
    border-radius: 12px;
    box-shadow: 0 10px 20px -10px rgba(43, 27, 94, 0.45);
  }

  .sp-logo-tile img {
    max-width: 100%;
    max-height: 50px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .sp-logo-tile--dark {
    background: #1c1c1f;
    border-color: #3a3a40;
  }

  .sp-logo-tile--cover {
    flex: 0 0 118px;
    height: 66px;
    padding: 0;
    overflow: hidden;
    border-radius: 12px;
  }

  .sp-logo-tile--cover img {
    max-height: none;
    max-width: calc(100% - 1rem);
    width: auto;
    height: 96%;
    object-fit: contain;
  }

  .sp-logo-tile--cover-fill {
    padding: 0;
    overflow: hidden;
  }

  .sp-logo-tile--cover-fill img {
    max-height: none;
    max-width: 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
  }

  .sp-logo-tile--cover {
    display: grid;
    place-items: center;
  }

  .sp-name {
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }

  .cta-sponsor {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 3rem 2rem;
    border: 2px solid transparent;
    background:
      linear-gradient(135deg, var(--turquesa), var(--brand-600), var(--brand-900))
        padding-box,
      linear-gradient(135deg, #7be8f4, var(--lavanda)) border-box;
    border-radius: calc(var(--radius) + 6px);
    margin-top: 2rem;
    box-shadow: 0 24px 50px -20px rgba(43, 27, 94, 0.6);
  }

  .cta-sponsor::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.22) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .cta-sponsor::after {
    content: '';
    position: absolute;
    bottom: -50%;
    left: -12%;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(187, 140, 255, 0.28) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .cta-sponsor h3,
  .cta-sponsor p,
  .cta-sponsor .btn {
    position: relative;
    z-index: 1;
  }

  .cta-sponsor h3 {
    color: #fff;
    font-size: 1.7rem;
    margin-bottom: 0.6rem;
    letter-spacing: 0.01em;
  }

  .cta-sponsor p {
    margin-bottom: 1.4rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.02rem;
  }
</style>