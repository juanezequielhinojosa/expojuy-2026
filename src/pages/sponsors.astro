---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import { sponsors } from '../data/sponsors';

const thematics = ['award', 'target', 'sparkles', 'heart', 'truck', 'globe'];
const iconFor = (i: number) => thematics[i % thematics.length];
---

<Layout
  title="Sponsors"
  description="Instituciones y sponsors que acompañan ExpoJuy 2026."
>
  <section class="section">
    <div class="container">
      <SectionTitle
        kicker="Sponsors"
        title="Quiénes nos acompañan"
        lede="Instituciones públicas y privadas que hacen posible la muestra. El listado final se actualiza con el programa oficial."
      />

      <div class="sponsor-block">
        <h3>Institucional</h3>
        <div class="sponsor-grid">
          {sponsors
            .filter((s) => s.level === 'Institucional')
            .map((s, i) => (
              <div class="sponsor-card">
                <span class="sp-icon-tile" aria-hidden="true">
                  <Icon name="building" size={22} strokeWidth={1.8} />
                </span>
                <span class="sp-name">{s.name}</span>
              </div>
            ))}
        </div>
      </div>

      <div class="sponsor-block">
        <h3>Sponsors comerciales</h3>
        <div class="sponsor-grid">
          {sponsors
            .filter((s) => s.level !== 'Institucional')
            .map((s, i) => (
              <div class="sponsor-card">
                <span class="sp-icon-tile sp-icon-tile--gold" aria-hidden="true">
                  <Icon name={iconFor(i)} size={22} strokeWidth={1.8} />
                </span>
                <span class="sp-name">{s.name}</span>
                <span class="sp-level">{s.level}</span>
              </div>
            ))}
        </div>
      </div>

      <div class="cta-sponsor">
        <h3>¿Querés ser sponsor?</h3>
        <p>
          Sumá tu marca a la vidriera más importante del norte argentino.
        </p>
        <a class="btn btn-accent" href="/contacto/">Hablemos</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sponsor-block {
    margin-bottom: 2.5rem;
  }

  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
  }

  .sponsor-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    box-shadow: var(--shadow);
  }

  .sp-icon-tile {
    flex: 0 0 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, var(--brand-600), var(--brand-900));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 8px 18px -8px rgba(3, 47, 71, 0.5);
  }

  .sp-icon-tile--gold {
    background: linear-gradient(135deg, #e8a33d, #8a5a13);
    color: #fff;
  }

  .sp-name {
    font-weight: 600;
    color: var(--brand-900);
    line-height: 1.3;
  }

  .sp-level {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-terracotta);
    white-space: nowrap;
  }

  .cta-sponsor {
    text-align: center;
    padding: 2.5rem 1.5rem;
    background: var(--brand-900);
    color: #fff;
    border-radius: var(--radius);
    margin-top: 1.5rem;
  }

  .cta-sponsor h3 {
    color: #fff;
  }

  .cta-sponsor p {
    margin-bottom: 1.2rem;
    color: rgba(255, 255, 255, 0.85);
  }
</style>