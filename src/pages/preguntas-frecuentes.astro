---
// Página: Preguntas frecuentes
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import { faqs } from '../data/faqs';
---

<Layout
  title="Preguntas frecuentes"
  description="Respuestas a las dudas más comunes sobre ExpoJuy 2026."
>
  <section class="section section-decor">
    <div class="container narrow">
      <SectionTitle
        kicker="Ayuda"
        title="Preguntas frecuentes"
        lede="Recopilamos las consultas más habituales sobre la feria, las entradas, los expositores y el predio."
      />

      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <Icon name="chevron" size={18} />
              <span>{f.question}</span>
            </summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>

      <p class="more-help">
        ¿Quedó alguna duda? <a href="/contacto/">Escribinos</a> y te
        respondemos.
      </p>
    </div>
  </section>
</Layout>

<style>
  .narrow {
    max-width: 760px;
  }

  .more-help {
    margin-top: 1.5rem;
    text-align: center;
  }

  .faq-list {
    display: grid;
    gap: 1rem;
  }

  .faq-item {
    border: 1px solid transparent;
    border-radius: var(--radius);
background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--turquesa) 55%, transparent),
        color-mix(in srgb, var(--brand-500) 65%, transparent)
      )
      border-box;
    box-shadow: var(--shadow);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.6rem;
    padding: 1.1rem 1.3rem;
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--ink);
    list-style: none;
    cursor: pointer;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    display: none;
  }

  .faq-item summary svg {
    flex: none;
    color: var(--turquesa);
    transition: transform 0.2s ease;
  }

  .faq-item[open] summary svg {
    transform: rotate(90deg);
  }

  .faq-item > p {
    margin: 0;
    padding: 0 1.3rem 1.1rem;
    color: var(--muted);
  }
</style>