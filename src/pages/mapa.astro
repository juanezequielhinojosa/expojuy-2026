---
// Página: Mapa y accesos al predio
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Mapa"
  description="Cómo llegar y plano del predio de ExpoJuy 2026 en la Ciudad Cultural de San Salvador de Jujuy."
>
  <section class="section">
    <div class="container">
      <SectionTitle
        kicker="Mapa y accesos"
        title="Cómo llegar al predio"
        lede="ExpoJuy 2026 se realiza en la Ciudad Cultural, a pocos minutos del centro de San Salvador de Jujuy."
      />

      <div class="map-grid">
        <div class="map-embed">
          <iframe
            title="Mapa de la Ciudad Cultural, San Salvador de Jujuy"
            src="https://maps.google.com/maps?q=Ciudad%20Cultural%2C%20San%20Salvador%20de%20Jujuy&z=15&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

          <aside class="map-info">
          <h3>Accesos y recomendaciones</h3>
          <ul class="accesos">
            <li class="acceso" style="--from:#25C0D4;--to:#6143C9">
              <span class="acceso-ico" aria-hidden="true">
                <Icon name="mappin" size={19} strokeWidth={1.8} />
              </span>
              <div class="acceso-body">
                <strong>Dirección</strong>
                <span>Predio ferial de la Ciudad Cultural, San Salvador de Jujuy.</span>
              </div>
            </li>
            <li class="acceso" style="--from:#774FF0;--to:#25C0D4">
              <span class="acceso-ico" aria-hidden="true">
                <Icon name="target" size={19} strokeWidth={1.8} />
              </span>
              <div class="acceso-body">
                <strong>Centro</strong>
                <span>A pocos minutos del centro de la ciudad capital.</span>
              </div>
            </li>
            <li class="acceso" style="--from:#25C0D4;--to:#820CD0">
              <span class="acceso-ico" aria-hidden="true">
                <Icon name="truck" size={19} strokeWidth={1.8} />
              </span>
              <div class="acceso-body">
                <strong>Transporte</strong>
                <span>Líneas de colectivo urbano con paradas en el predio y estacionamiento para autos.</span>
              </div>
            </li>
            <li class="acceso" style="--from:#BB8CFF;--to:#25C0D4">
              <span class="acceso-ico" aria-hidden="true">
                <Icon name="heart" size={19} strokeWidth={1.8} />
              </span>
              <div class="acceso-body">
                <strong>Accesibilidad</strong>
                <span>Rampas y recorridos accesibles en todo el predio.</span>
              </div>
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .map-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .map-embed iframe {
    width: 100%;
    height: 420px;
    border: 0;
    border-radius: var(--radius);
    box-shadow:
      0 28px 60px -18px rgba(59, 42, 130, 0.45),
      0 14px 32px -10px rgba(37, 192, 212, 0.4);
    filter: saturate(0.9);
  }

  .map-info {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .accesos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }

  .acceso {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .acceso:hover {
    transform: translateY(-3px);
    box-shadow:
      0 18px 36px -16px rgba(43, 27, 94, 0.3),
      -14px 18px 40px -14px rgba(37, 192, 212, 0.45),
      14px -18px 40px -14px rgba(119, 79, 240, 0.55);
  }

  .acceso-ico {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--from), var(--to));
    box-shadow: 0 10px 22px -8px rgba(37, 192, 212, 0.45);
  }

  .acceso-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .acceso-body strong {
    color: var(--ink);
  }

  .acceso-body span {
    color: var(--muted);
    font-size: 0.93rem;
  }

  @media (max-width: 820px) {
    .map-grid {
      grid-template-columns: 1fr;
    }
  }
</style>