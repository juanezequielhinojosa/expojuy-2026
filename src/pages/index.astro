---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import NewsCard from '../components/NewsCard.astro';
import SectorIcon from '../components/SectorIcon.astro';
import Icon from '../components/Icon.astro';
import CerrosScene from '../components/CerrosScene.astro';
import { site } from '../data/site';
import { news } from '../data/news';
import { rubros } from '../data/exhibitors';

const reasons = [
  {
    icon: 'globe',
    title: 'Corredor Bioceánico',
    text: 'La plataforma de integración con Chile, Paraguay, Brasil y Bolivia que abre mercados a la producción jujeña.',
  },
  {
    icon: 'gem',
    title: 'Minería sustentable',
    text: 'La cadena de valor de la Puna, el litio y la energía como ejes del desarrollo provincial.',
  },
  {
    icon: 'cpu',
    title: 'Economía del conocimiento',
    text: 'Tecnología, innovación y talento jujeño con iniciativas como el Desafío Digital ExpoJuy 2026.',
  },
  {
    icon: 'mountain',
    title: 'Turismo y cultura',
    text: 'La Quebrada, las salinas y la identidad del norte argentino como destino y experiencia.',
  },
];

const agendaHighlights = [
  {
    icon: 'truck',
    title: 'Rondas de negocios',
    text: 'Encuentros entre empresas locales y delegaciones de Argentina, Chile, Paraguay y Brasil vinculados al Corredor Bioceánico de Capricornio.',
  },
  {
    icon: 'mic',
    title: 'Foros sectoriales',
    text: 'Minería sustentable, economía del conocimiento, turismo de la Quebrada y Puna, y oportunidades para el interior provincial.',
  },
  {
    icon: 'heart',
    title: 'Cultura y tradición',
    text: 'Espectáculos en vivo, feria de artesanos, gastronomía regional y la identidad del norte argentino en cada jornada.',
  },
];
---

<Layout
  title={site.title}
  description="ExpoJuy 2026: la muestra multisectorial más importante del norte argentino. Del 9 al 12 de octubre en la Ciudad Cultural, San Salvador de Jujuy."
>
  <Hero />

  <section class="section section-decor" aria-labelledby="sectores">
    <div class="container">
      <SectionTitle
        kicker="Sectores"
        title="La diversidad productiva de Jujuy"
        lede="Minería, agroindustria, turismo, tecnología y más, en una sola vidriera."
      />
      <div class="sector-grid">
        {
          rubros.map((r) => (
            <a class="sector-tile" href={`/expositores/?rubro=${encodeURIComponent(r)}`}>
              <SectorIcon rubro={r} size="lg" />
              <span class="sector-tile-name">{r}</span>
              <span class="sector-tile-go" aria-hidden="true">
                <Icon name="arrow" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="por-que">
    <div class="container">
      <SectionTitle
        kicker="En una mirada"
        title="Por qué ExpoJuy"
        lede="Cuatro ejes convierten la feria en el punto de encuentro estratégico del norte argentino."
      />
      <div class="reason-grid">
        {
          reasons.map((r) => (
            <article class="reason-card">
              <span class="icon-circle icon-circle--gold">
                <Icon name={r.icon} size={26} strokeWidth={1.8} />
              </span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-decor" aria-labelledby="destacados-agenda">
    <div class="container">
      <SectionTitle
        kicker="Agenda"
        title="Destacados del programa"
        lede="Rondas de negocios internacionales, foros sectoriales y una agenda cultural que recorre la identidad jujeña."
      />
      <div class="feature-list">
        {
          agendaHighlights.map((f, i) => (
            <article class="feature">
              <span class="feature-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="icon-circle">
                <Icon name={f.icon} size={24} strokeWidth={1.8} />
              </span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
      <p class="feature-cta">
        <a class="btn btn-primary" href="/agenda/">
          Ver la agenda completa <Icon name="calendar" size={18} />
        </a>
      </p>
    </div>
  </section>

  <section class="section section-alt" id="novedades" aria-labelledby="novedades">
    <div class="container">
      <SectionTitle kicker="Novedades" title="Noticias de ExpoJuy 2026" />
      <div class="grid grid-2">
        {news.slice(0, 3).map((item, i) => <NewsCard item={item} index={i} />)}
      </div>
      <p class="feature-cta">
        <a class="btn btn-outline" href="/noticias/">
          Todas las noticias <Icon name="arrow" size={17} />
        </a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="cta">
    <div class="container">
      <div class="cta-band">
        <CerrosScene class="cta-scene" />
        <div class="cta-content">
          <span class="cta-kicker">Sumá tu propuesta</span>
          <h2>¿Querés ser parte de ExpoJuy 2026?</h2>
          <p>
            Expositor, sponsor o visitante: escribinos y sumá tu propuesta al
            encuentro más convocante del norte argentino.
          </p>
          <div class="cta-actions">
            <a class="btn btn-accent" href="/contacto/">
              Contáctanos <Icon name="send" size={18} />
            </a>
            <a class="btn btn-outline btn-dark" href="/expositores/">
              Ver expositores <Icon name="arrow" size={18} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sector-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.1rem;
  }

  .sector-tile {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.15rem 1.25rem;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .sector-tile:hover {
    transform: translateY(-4px);
    border-color: rgba(4, 68, 99, 0.35);
    box-shadow: 0 18px 36px -16px rgba(3, 47, 71, 0.3);
  }

  .sector-tile-name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--brand-900);
  }

  .sector-tile-go {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--brand-800);
    background: rgba(4, 68, 99, 0.07);
    transition: all 0.2s ease;
  }

  .sector-tile:hover .sector-tile-go {
    background: var(--brand-800);
    color: #fff;
  }

  .reason-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .reason-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease;
  }

  .reason-card:hover {
    transform: translateY(-3px);
  }

  .reason-card h3 {
    margin: 1rem 0 0.5rem;
  }

  .reason-card p {
    margin: 0;
  }

  .feature-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .feature {
    position: relative;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem 1.5rem;
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.2s ease;
  }

  .feature:hover {
    transform: translateY(-3px);
  }

  .feature::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, var(--brand-800), var(--accent-gold));
  }

  .feature-num {
    position: absolute;
    top: 1.1rem;
    right: 1.4rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.9rem;
    color: rgba(4, 68, 99, 0.12);
  }

  .feature h3 {
    font-size: 1.15rem;
    margin: 1rem 0 0.5rem;
  }

  .feature p {
    margin: 0;
  }

  .feature-cta {
    text-align: center;
    margin: 2rem 0 0;
  }

  .cta-band {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background:
      radial-gradient(700px 300px at 85% -30%, rgba(10, 116, 165, 0.5), transparent 60%),
      linear-gradient(135deg, #032f47, #065a82);
    padding: 3rem 2.5rem;
    box-shadow: 0 30px 60px -20px rgba(3, 47, 71, 0.5);
  }

  .cta-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    max-width: 40em;
    color: #fff;
  }

  .cta-kicker {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .cta-band h2 {
    color: #fff;
    margin: 0.6rem 0 0.6rem;
  }

  .cta-band p {
    margin: 0 0 1.4rem;
    color: rgba(255, 255, 255, 0.88);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .btn-dark {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
    box-shadow: none;
  }

  .btn-dark:hover {
    background: #fff;
    color: var(--brand-900);
  }
</style>