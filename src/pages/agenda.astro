---
// Página: Agenda diaria con pestañas por día
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import { agenda, days } from '../data/agenda';

const dayIcons: Record<string, string> = {
  vie9: 'sun',
  sab10: 'calendar',
  dom11: 'heart',
  lun12: 'award',
};

const typeIcons: Record<string, string> = {
  Institucional: 'building',
  Negocios: 'truck',
  Charlas: 'mic',
  Cultural: 'heart',
  Foros: 'users',
  Feria: 'cart',
};

const TYPE_COLORS: Record<string, { from: string; to: string }> = {
  Institucional: { from: '#4E3AA8', to: '#25C0D4' },
  Negocios:      { from: '#25C0D4', to: '#6143C9' },
  Charlas:       { from: '#774FF0', to: '#25C0D4' },
  Cultural:      { from: '#A18BFF', to: '#25C0D4' },
  Foros:         { from: '#25C0D4', to: '#820CD0' },
  Feria:         { from: '#25C0D4', to: '#BB8CFF' },
};
---

<Layout
  title="Agenda"
  description="Agenda de actividades de ExpoJuy 2026, del 9 al 12 de octubre en la Ciudad Cultural de Jujuy."
>
  <section class="section">
    <div class="container">
      <SectionTitle
        kicker="Agenda 2026"
        title="Programa de actividades"
        lede="Cuatro días con rondas de negocios, foros, ferias y espectáculos. Programa sujeto a confirmación oficial."
      />

      <div class="tabs" role="tablist" aria-label="Días de la feria" data-tabs>
        {days.map((d, i) => (
          <button
            class="tab-btn"
            id={`tab-${d.id}`}
            role="tab"
            aria-controls={`panel-${d.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? '0' : '-1'}
            data-tab={d.id}
          >
            <Icon name={dayIcons[d.id] ?? 'calendar'} size={16} />
            {d.label}
          </button>
        ))}
      </div>

      {days.map((d, idx) => {
        const items = agenda.filter((a) => a.day === d.id);
        return (
          <div
            class="tab-panel"
            id={`panel-${d.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${d.id}`}
            data-panel={d.id}
            hidden={idx !== 0}
          >
            <div class="table-wrap">
              <table class="agenda-table">
                <thead>
                  <tr>
                    <th scope="col">Hora</th>
                    <th scope="col">Actividad</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Lugar</th>
                  </tr>
                </thead>
                <tbody>
                  {items.map((a) => (
                    <tr>
                      <td>{a.time}</td>
                      <td>{a.title}</td>
                      <td>
                        <span
                          class="chip type-chip"
                          style={`--from:${TYPE_COLORS[a.type]?.from ?? '#4E3AA8'};--to:${TYPE_COLORS[a.type]?.to ?? '#25C0D4'}`}
                        >
                          <span class="type-ico" aria-hidden="true">
                            <Icon name={typeIcons[a.type] ?? 'info'} size={13} />
                          </span>
                          {a.type}
                        </span>
                      </td>
                      <td>{a.place}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>

<style>
  .tab-panel[hidden] {
    display: none;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .tab-btn svg {
    color: var(--turquesa);
  }

  .tab-btn[aria-selected='true'] {
    background: linear-gradient(135deg, var(--turquesa), var(--brand-500));
    border-color: transparent;
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(37, 192, 212, 0.55);
  }

  .tab-btn[aria-selected='true'] svg {
    color: #fff;
  }

  .type-chip {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.85rem 0.25rem 0.3rem;
    border: 1px solid color-mix(in srgb, var(--turquesa) 45%, transparent);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--turquesa);
    background: color-mix(in srgb, var(--turquesa) 10%, transparent);
  }

  .type-ico {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    color: #fff;
    background: linear-gradient(135deg, var(--from), var(--to));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 4px 10px -4px rgba(43, 27, 94, 0.5);
  }

  .agenda-table td:first-child {
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
</style>

<script>
  const tabs = document.querySelector('[data-tabs]');
  const panels = Array.from(document.querySelectorAll('[data-panel]'));

  const show = (id) => {
    for (const btn of tabs?.querySelectorAll('[data-tab]') ?? []) {
      const selected = btn.dataset.tab === id;
      btn.setAttribute('aria-selected', String(selected));
      btn.tabIndex = selected ? 0 : -1;
    }
    for (const panel of panels) {
      panel.hidden = panel.dataset.panel !== id;
    }
  };

  tabs?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-tab]');
    if (btn) {
      show(btn.dataset.tab);
      btn.focus();
    }
  });

  const firstTab = tabs?.querySelector('[data-tab]');
  if (firstTab) show(firstTab.dataset.tab);
</script>