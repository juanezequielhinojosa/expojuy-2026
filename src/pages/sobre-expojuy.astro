---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';

const ejes = [
  {
    icon: 'globe',
    title: 'Corredor Bioceánico de Capricornio',
    text: 'La feria se proyecta como plataforma de integración con Chile, Paraguay, Brasil y Bolivia, conectando la oferta local con la demanda internacional.',
  },
  {
    icon: 'gem',
    title: 'Minería sustentable',
    text: 'La cadena de valor minera es uno de los ejes centrales de la edición 2026, con énfasis en la Puna y el litio.',
  },
  {
    icon: 'cpu',
    title: 'Economía del Conocimiento',
    text: 'Tecnología, innovación y talento jujeño, con iniciativas como el Desafío Digital ExpoJuy 2026.',
  },
  {
    icon: 'mountain',
    title: 'Interior provincial',
    text: 'Potenciar la participación de productores y emprendedores de todas las localidades de Jujuy.',
  },
];
---

<Layout
  title="Sobre ExpoJuy 2026"
  description="Conocé ExpoJuy, la muestra multisectorial del norte argentino organizada por la Cámara de Comercio Exterior de Jujuy."
>
  <section class="section">
    <div class="container narrow">
      <SectionTitle
        kicker="Sobre ExpoJuy 2026"
        title="Conectando países, creando oportunidades"
        lede="ExpoJuy es el encuentro productivo, comercial, institucional e internacional más importante del norte argentino."
      />

      <p>
        Organizada por la <strong>Cámara de Comercio Exterior de Jujuy</strong>{' '}
        y con el acompañamiento del Gobierno de la Provincia, ExpoJuy reúne a
        empresas, pymes, emprendedores, instituciones, productores y artistas
        de Jujuy y de la región. En cada edición se convierte en la vidriera de
        la producción, el turismo y la cultura de la provincia.
      </p>

      <p>
        La edición 2026 llega con un <strong>formato renovado de cuatro
        días</strong> (del 9 al 12 de octubre), con actividades por la mañana y
        por la tarde: rondas de negocios, foros sectoriales, exposiciones y una
        agenda cultural intensa.
      </p>

      <h3>Nuestros ejes</h3>
      <div class="ejes-list">
        {
          ejes.map((e) => (
            <div class="eje">
              <span class="icon-circle">
                <Icon name={e.icon} size={22} strokeWidth={1.8} />
              </span>
              <div>
                <strong>{e.title}:</strong> {e.text}
              </div>
            </div>
          ))
        }
      </div>

      <h3>Datos útiles</h3>
      <ul class="plain-list">
        <li>
          <Icon name="mappin" size={16} />
          <span><strong>Lugar:</strong> Ciudad Cultural, San Salvador de Jujuy, Argentina.</span>
        </li>
        <li>
          <Icon name="calendar" size={16} />
          <span><strong>Fechas:</strong> del 9 al 12 de octubre de 2026.</span>
        </li>
        <li>
          <Icon name="ticket" size={16} />
          <span><strong>Accesos:</strong> con entrada general; consultá la sección entradas para novedades.</span>
        </li>
      </ul>

      <div class="note">
        <p>
          Este sitio es una <strong>propuesta conceptual</strong> presentada en
          el marco del Desafío Digital ExpoJuy 2026. El contenido institucional
          se basa en información pública del evento.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow {
    max-width: 760px;
  }

  .plain-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  .plain-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
  }

  .plain-list li > span {
    flex: 1;
  }

  .plain-list li > svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--brand-700);
  }

  .ejes-list {
    display: grid;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }

  .eje {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    box-shadow: var(--shadow);
  }

  .eje strong {
    color: var(--brand-900);
  }

  .note {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--accent-gold);
    border-radius: var(--radius);
    background: rgba(232, 163, 61, 0.08);
    font-size: 0.9rem;
  }

  .note p {
    margin: 0;
  }
</style>