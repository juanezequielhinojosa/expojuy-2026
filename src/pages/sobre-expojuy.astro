---
// Página: Sobre ExpoJuy (organización, ejes y datos)
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL;

const ejes = [
  {
    icon: 'globe',
    title: 'Corredor Bioceánico de Capricornio',
    text: 'La feria se proyecta como plataforma de integración con Chile, Paraguay, Brasil y Bolivia, conectando la oferta local con la demanda internacional.',
  },
  {
    icon: 'gem',
    title: 'Minería sustentable',
    text: 'La cadena de valor minera es uno de los ejes centrales de la edición 2026, con énfasis en la Puna y el litio.',
  },
  {
    icon: 'cpu',
    title: 'Economía del Conocimiento',
    text: 'Tecnología, innovación y talento jujeño, con iniciativas como el Desafío Digital ExpoJuy 2026.',
  },
  {
    icon: 'mountain',
    title: 'Interior provincial',
    text: 'Potenciar la participación de productores y emprendedores de todas las localidades de Jujuy.',
  },
];
---

<Layout
  title="Sobre ExpoJuy 2026"
  description="Conocé ExpoJuy, la muestra multisectorial del norte argentino organizada por la Cámara de Comercio Exterior de Jujuy."
>
  <section class="section">
    <div class="container narrow">
      <SectionTitle
        kicker="Sobre ExpoJuy 2026"
        title="Conectando países, creando oportunidades"
        lede="ExpoJuy es el encuentro productivo, comercial, institucional e internacional más importante del norte argentino."
      />

      <div class="intro">
        <div class="intro-panel">
          <span class="intro-logo-wrap">
            <img
              class="intro-logo"
              src={base + 'logos/logo-camara.png'}
              alt="Cámara de Comercio Exterior de Jujuy"
              width="140"
              height="114"
            />
          </span>
          <p>
            Organizada por la <strong>Cámara de Comercio Exterior de Jujuy</strong>{' '}
            y con el acompañamiento del Gobierno de la Provincia, ExpoJuy reúne a
            empresas, pymes, emprendedores, instituciones, productores y artistas
            de Jujuy y de la región. En cada edición se convierte en la vidriera de
            la producción, el turismo y la cultura de la provincia.
          </p>
        </div>
      </div>

      <p>
        La edición 2026 llega con un <strong>formato renovado de cuatro
        días</strong> (del 9 al 12 de octubre), con actividades por la mañana y
        por la tarde: rondas de negocios, foros sectoriales, exposiciones y una
        agenda cultural intensa.
      </p>

      <h3>Nuestros ejes</h3>
      <div class="ejes-list">
        {
          ejes.map((e) => (
            <div class="eje">
              <span class="eje-ico">
                <Icon name={e.icon} size={22} strokeWidth={1.8} />
              </span>
              <div>
                <strong>{e.title}:</strong> {e.text}
              </div>
            </div>
          ))
        }
      </div>

      <h3>Datos útiles</h3>
      <div class="datos-grid">
        <div class="dato">
          <span class="dato-ico" aria-hidden="true">
            <Icon name="mappin" size={20} strokeWidth={1.8} />
          </span>
          <div class="dato-body">
            <strong>Lugar</strong>
            <span>Ciudad Cultural, San Salvador de Jujuy, Argentina.</span>
          </div>
        </div>
        <div class="dato">
          <span class="dato-ico" aria-hidden="true">
            <Icon name="calendar" size={20} strokeWidth={1.8} />
          </span>
          <div class="dato-body">
            <strong>Fechas</strong>
            <span>Del 9 al 12 de octubre de 2026.</span>
          </div>
        </div>
        <div class="dato">
          <span class="dato-ico" aria-hidden="true">
            <Icon name="ticket" size={20} strokeWidth={1.8} />
          </span>
          <div class="dato-body">
            <strong>Accesos</strong>
            <span>Con entrada general; consultá la sección entradas para novedades.</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow {
    max-width: 760px;
  }

  .intro {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .intro-panel {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    width: 100%;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg);
    box-shadow: var(--shadow);
  }

  .intro-logo-wrap {
    display: grid;
    place-items: center;
    flex: none;
    padding: 0.6rem 0.85rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 12px 26px -14px rgba(43, 27, 94, 0.35);
  }

  .intro-logo {
    width: 128px;
    height: auto;
    display: block;
  }

  .intro p {
    margin: 0;
    line-height: 1.65;
  }

  .ejes-list {
    display: grid;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }

  .eje {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .eje:hover {
    transform: translateY(-4px);
    box-shadow:
      0 22px 42px -18px rgba(43, 27, 94, 0.32),
      -18px 22px 46px -16px rgba(37, 192, 212, 0.5),
      18px -22px 46px -16px rgba(119, 79, 240, 0.6);
  }

  .eje-ico {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--turquesa), var(--brand-500));
    box-shadow: 0 10px 22px -8px rgba(37, 192, 212, 0.45);
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.4));
  }

  .eje strong {
    color: var(--ink);
  }

  .datos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin: 0 0 1.5rem;
  }

  .dato {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    box-shadow: var(--shadow);
  }

  .dato-ico {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--turquesa), var(--brand-500));
    box-shadow: 0 10px 22px -8px rgba(37, 192, 212, 0.45);
  }

  .dato-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .dato-body strong {
    color: var(--ink);
  }

  .dato-body span {
    color: var(--muted);
    font-size: 0.93rem;
  }

  @media (max-width: 620px) {
    .intro-panel {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1.2rem 1.1rem;
    }

    .intro-logo-wrap {
      padding: 0.5rem 0.7rem;
    }

    .intro-logo {
      width: 108px;
    }
  }
</style>