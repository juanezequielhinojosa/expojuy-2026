---
// Página: Contacto con formulario y datos de la organización
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import SocialIcon from '../components/SocialIcon.astro';
import ContactForm from '../components/react/ContactForm.tsx';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;

const socialKey: Record<string, string> = {
  Instagram: 'instagram',
  Facebook: 'facebook',
  'X / Twitter': 'x',
  LinkedIn: 'linkedin',
  YouTube: 'youtube',
};
---

<Layout
  title="Contacto"
  description="Comunicate con la organización de ExpoJuy 2026."
>
  <section class="section">
    <div class="container contact-grid">
      <div>
        <SectionTitle
          kicker="Contacto"
          title="Escribinos"
          lede="Consultá por expositores, sponsors, prensa, voluntariado o cualquier otra consulta sobre ExpoJuy 2026."
        />

        <ContactForm client:load />
      </div>

<aside class="contact-side">
          <div class="side-card">
            <h3>Organización</h3>
            <img class="org-logo" src={base + 'logos/logo-camara.png'} alt={site.organizer} loading="lazy" />
            <p class="org-name">{site.organizer}</p>
            <p class="org-row mail">
              <span class="org-ico"><Icon name="mail" size={17} /></span>
              <span>
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </span>
            </p>
          </div>

          <div class="side-card">
            <h3>Redes sociales</h3>
            <ul class="social-list">
              {site.social.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                    <span class="social-tile">
                      <SocialIcon name={socialKey[s.name] ?? 'globe'} size={18} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 3rem;
    align-items: start;
  }

  /* ---------- Tarjetas del aside ---------- */
  .side-card {
    padding: 1.35rem 1.45rem;
    margin-bottom: 1.4rem;
    border: 2px solid transparent;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(135deg, var(--turquesa), var(--brand-500)) border-box;
    border-radius: var(--radius);
    box-shadow: 0 16px 34px -22px rgba(43, 27, 94, 0.35);
  }

  .side-card h3 {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    letter-spacing: 0.3px;
  }

  .org-logo {
    display: block;
    width: 100%;
    height: auto;
    max-height: 96px;
    object-fit: contain;
    object-position: center;
    margin: 0 0 0.8rem;
    padding: 0.55rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
  }

  .org-name {
    margin: 0 0 0.9rem;
    text-align: center;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .org-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 0.7rem;
    font-size: 0.95rem;
  }

  .org-ico {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: color-mix(in srgb, var(--turquesa) 12%, transparent);
  }

  .org-ico svg {
    color: var(--turquesa);
  }

  .org-row.mail a {
    font-weight: 600;
    color: var(--link);
  }

  .social-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
  }

  .social-list a {
    display: block;
  }

  .social-tile {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--turquesa), var(--brand-500));
    box-shadow: 0 10px 22px -8px rgba(37, 192, 212, 0.45);
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.3));
    transition: all 0.2s ease;
  }

  .social-tile:hover {
    transform: translateY(-2px) scale(1.04);
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.35));
  }

  .social-tile svg {
    width: 20px;
    height: 20px;
    color: #fff;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>