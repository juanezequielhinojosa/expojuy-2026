---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../data/site';

const socialKey: Record<string, string> = {
  Instagram: 'instagram',
  Facebook: 'facebook',
  'X / Twitter': 'x',
  LinkedIn: 'linkedin',
  YouTube: 'youtube',
};
---

<Layout
  title="Contacto"
  description="Comunicate con la organización de ExpoJuy 2026."
>
  <section class="section">
    <div class="container contact-grid">
      <div>
        <SectionTitle
          kicker="Contacto"
          title="Escribinos"
          lede="Consultá por expositores, sponsors, prensa, voluntariado o cualquier otra consulta sobre ExpoJuy 2026."
        />

        <form class="contact-form" data-contact-form novalidate>
          <div class="field">
            <label for="nombre">Nombre completo *</label>
            <input id="nombre" name="nombre" type="text" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="email">Correo electrónico *</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="tema">Tema</label>
            <select id="tema" name="tema">
              <option value="expositor">Quiero ser expositor</option>
              <option value="sponsor">Quiero ser sponsor</option>
              <option value="entradas">Entradas</option>
              <option value="prensa">Prensa</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div class="field">
            <label for="mensaje">Mensaje *</label>
            <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
          </div>

          <button class="btn btn-primary" type="submit">Enviar consulta</button>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="contact-side">
        <h3>Organización</h3>
        <p class="org-row">
          <Icon name="building" size={17} />
          <span>{site.organizer}</span>
        </p>
        <p class="org-row mail">
          <Icon name="mail" size={17} />
          <span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </span>
        </p>

        <h3>Redes sociales</h3>
        <ul class="social-list">
          {site.social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                <span class="social-tile">
                  <SocialIcon name={socialKey[s.name] ?? 'globe'} size={18} />
                  {s.name}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="note">
          <strong>Prototipo:</strong> este formulario es parte de la propuesta
          conceptual; el envío aún no se conecta a un servidor.
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-form .btn {
    margin-top: 0.5rem;
  }

  .form-status {
    margin-top: 0.9rem;
    font-weight: 600;
  }

  .form-status.ok {
    color: #1e7d46;
  }

  .form-status.error {
    color: var(--accent-terracotta);
  }

  .contact-side h3 {
    font-size: 1.15rem;
    margin-top: 1.5rem;
  }

  .org-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
  }

  .org-row svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--brand-700);
  }

  .org-row.mail a {
    font-weight: 600;
  }

  .social-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social-list li {
    margin-bottom: 0.5rem;
  }

  .social-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .social-tile {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(4, 68, 99, 0.2);
    border-radius: 999px;
    background: rgba(4, 68, 99, 0.06);
    transition: all 0.2s ease;
  }

  .social-tile:hover {
    border-color: var(--brand-800);
    background: rgba(4, 68, 99, 0.1);
  }

  .social-tile svg {
    color: var(--brand-800);
  }

  .note {
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px dashed var(--accent-gold);
    border-radius: var(--radius);
    background: rgba(232, 163, 61, 0.08);
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

<script>
  const form = document.querySelector('[data-contact-form]');
  const status = document.querySelector('[data-form-status]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const valid = form.checkValidity();
    if (!valid) {
      form.reportValidity();
      return;
    }
    if (status) {
      status.textContent =
        'Gracias por tu mensaje. En el sitio final, tu consulta se enviará a la organización de ExpoJuy.';
      status.className = 'form-status ok';
    }
    form.reset();
  });
</script>